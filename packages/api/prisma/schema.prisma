// O dominio GLP-1 e exclusivamente de registro e acompanhamento. Nenhum campo
// abaixo representa recomendacao, ajuste ou prescricao de dose pelo sistema.
enum Glp1TreatmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum Glp1Route {
  SUBCUTANEOUS
  ORAL
}

enum Glp1Source {
  USER
  PRESCRIPTION
  CLINICIAN
  PHARMACIST
  OTHER
}

enum Glp1DoseStatus {
  SCHEDULED
  TAKEN
  MISSED
  SKIPPED
  CANCELLED
}

model Glp1Consent {
