model ProductAnalyticsEvent {
  id String @id @default(cuid())

  // Identity — must work fully anonymously
  visitorId String
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  // Event
  eventName String
  stepId    String?
  stepIndex Int?
  direction String?

  // Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  ttclid      String?
  gclid       String?
  country     String?
  // Coarse age bucket ("18-24", "25-34", ...), computed client-side from the
  // quiz's birthDate step once answered. Never exact age/birthdate.
  ageRange    String?

  // Device (parsed server-side from User-Agent)
  platform   String?
  os         String?
  browser    String?
  deviceType String?

  properties Json?

  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([eventName])
  @@index([createdAt])
  @@index([utmCampaign])
  @@index([userId])
  @@map("product_analytics_events")
}

// Community - minimal text-only posts/comments/likes so users can share
// experiences with each other. Deliberately NOT linked to any health data
// (weight, doses, meals, symptoms) - a post is free text the user typed,
// never auto-populated from their tracked data (see product rules this
// mirrors: never present health info without an explicit user action).
// deletedAt is the single mechanism for both "author removed their own
// post/comment" and "an admin (isAdmin) moderated it" - CommunityService
// authorizes either, there is no separate moderation/hidden state.
model CommunityPost {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text              String
  imageUrl          String?
  videoUrl          String?
  videoThumbnailUrl String?
  audience          String    @default("PUBLIC")
  location          String?
  workoutMeta       Json?
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  comments CommunityComment[]
  likes    CommunityLike[]

  @@index([createdAt])
  @@index([userId])
  @@index([audience])
  @@map("community_posts")
}

model CommunityFriendship {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("community_friendships")
}

// parentCommentId is one level deep only, by product rule (see
// CommunityService.createComment): a reply's parent can never itself be a
// reply. onDelete: Cascade here only matters if a user's account is deleted
// (cascading from User); day-to-day comment/reply removal always goes
// through deletedAt (see CommunityService.deleteComment), which cascades
// the single level by hand since there is no recursion to worry about.
model CommunityComment {
  id              String             @id @default(cuid())
  postId          String
  post            CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  text            String
  parentCommentId String?
  parentComment   CommunityComment?  @relation("CommunityCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         CommunityComment[] @relation("CommunityCommentReplies")
  createdAt       DateTime           @default(now())
  deletedAt       DateTime?

  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentCommentId])
  @@map("community_comments")
}

// One row per (post, user) - unique constraint doubles as the "did I already
// like this" check and makes like/unlike a plain insert/delete, no counter
// to keep in sync by hand (counts are a live COUNT(*) at read time).
model CommunityLike {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_likes")
}

enum CommunityReportTargetType {
  POST
  COMMENT
  USER
}

// Durable record only - reporting takes no automated action (no
// auto-hide-after-N-reports), since that's an algorithmic moderation
// feature beyond this feature's minimal scope and easy to game. An admin
// reviews these directly (e.g. via Prisma Studio) for now.
model CommunityReport {
  id         String                    @id @default(cuid())
  reporterId String
  reporter   User                      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType CommunityReportTargetType
  targetId   String
  reason     String?
  createdAt  DateTime                  @default(now())

  // One report per user per piece of content - CommunityService.report()
  // pre-checks this for a friendly 409, the constraint is the hard backstop
  // for the concurrent-double-tap race.
  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("community_reports")
}

// AI support chat (see modules/support-chat) - separate from the plain
// contact-by-email SupportService/SUPPORT_EMAIL flow. Unlike community
// content, a conversation here is never visible to anyone but its owner, so
// SupportChatService.deleteConversation() hard-deletes (cascading to its
// messages) instead of the soft-delete used for public community content -
// there is no other user's reference to preserve, and this is the more
// privacy-respecting choice for what may include account/support questions.
model SupportChatConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // First ~60 chars of the opening message, set once at creation - just a
  // label if a conversation list UI is added later, never sent back to the
  // model as context.
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportChatMessage[]

  @@index([userId, updatedAt])
  @@map("support_chat_conversations")
}

// In-app "Suggestions" - unlike SupportService.contact() (plain email
// forward, nothing persisted), every submission here is saved durably so
// nothing is lost waiting on an inbox. The product owner reads these
// directly (via a future admin view or a DB query) rather than relying on
// email archaeology - SuggestionsService also best-effort emails
// SUPPORT_EMAIL when configured, but that's a convenience notification,
// not the source of truth.
model Suggestion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("suggestions")
}

enum SupportChatRole {
  USER
  ASSISTANT
}

model SupportChatMessage {
  id             String                  @id @default(cuid())
  conversationId String
  conversation   SupportChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           SupportChatRole
  text           String
  createdAt      DateTime                @default(now())

  @@index([conversationId, createdAt])
  @@map("support_chat_messages")
}

model DirectChatConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants DirectChatParticipant[]
  messages     DirectChatMessage[]

  @@map("direct_chat_conversations")
}

model DirectChatParticipant {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   DirectChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime               @default(now())
  joinedAt       DateTime               @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("direct_chat_participants")
}

model DirectChatMessage {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   DirectChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String                 @default("")
  imageUrl       String?
  createdAt      DateTime               @default(now())
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("direct_chat_messages")
}

model TrainerProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle          String?           @unique
  title           String            @default("Certified Fitness Trainer")
  bio             String            @default("")
  specialties     Json              @default("[]")
  certifications  Json              @default("[]")
  yearsExperience Int               @default(1)
  traineesCount   Int               @default(0)
  rating          Float             @default(5.0)
  reviewsCount    Int               @default(0)
  instagram       String?
  avatarUrl       String?
  coverUrl        String?
  verified        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customExercises TrainerExercise[]
  programs        TrainerProgram[]

  @@map("trainer_profiles")
}

model TrainerExercise {
  id             String         @id @default(cuid())
  trainerId      String
  trainer        TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name           String
  category       String         @default("STRENGTH")
  primaryMuscles Json           @default("[]")
  equipment      String         @default("BODYWEIGHT")
  instructions   String?
  imageUrl       String?
  videoUrl       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([trainerId])
  @@map("trainer_exercises")
}

model TrainerProgram {
  id            String                     @id @default(cuid())
  trainerId     String
  trainer       TrainerProfile             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title         String
  description   String                     @default("")
  goal          String                     @default("WEIGHT_LOSS")
  difficulty    String                     @default("INTERMEDIATE")
  durationWeeks Int                        @default(4)
  coverImageUrl String?
  isPublished   Boolean                    @default(true)
  daysJson      Json                       @default("[]")
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  enrollments   TrainerProgramEnrollment[]

  @@index([trainerId])
  @@index([goal])
  @@map("trainer_programs")
}

model TrainerProgramEnrollment {
  id            String         @id @default(cuid())
  programId     String
  program       TrainerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String         @default("ACTIVE")
  currentDay    Int            @default(1)
  completedDays Json           @default("[]")
  joinedAt      DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([programId, userId])
  @@index([userId])
  @@index([programId])
  @@map("trainer_program_enrollments")
}

model CommunityStory {
  clientRequestId String?
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String
  mediaType String    @default("IMAGE")
  caption   String?
  duration  Int       @default(5)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  views CommunityStoryView[]
  likes CommunityStoryLike[]

  @@unique([userId, clientRequestId])
  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("community_stories")
}

model CommunityStoryView {
  id       String         @id @default(cuid())
  storyId  String
  story    CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime       @default(now())

  @@unique([storyId, userId])
  @@map("community_story_views")
}

model CommunityStoryLike {
  id        String         @id @default(cuid())
  storyId   String
  story     CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([storyId, userId])
  @@map("community_story_likes")
}


model TrainingWorkout {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId String
  title String
  startedAt DateTime
  finishedAt DateTime
  durationSec Int
  completedSets Int
  createdAt DateTime @default(now())
  @@unique([userId, workoutId])
  @@index([finishedAt, userId])
  @@map("training_workouts")
}

model TrainingChallengeEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  weekStart DateTime
  joinedAt DateTime @default(now())
  @@unique([userId, challengeId, weekStart])
  @@map("training_challenge_entries")
}
