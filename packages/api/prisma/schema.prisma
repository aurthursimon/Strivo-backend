generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  passwordHash          String?
  name                  String
  avatarUrl             String?
  provider              AuthProvider           @default(EMAIL)
  providerId            String?
  emailVerified         Boolean                @default(false)
  emailVerifiedAt       DateTime?
  locale                String                 @default("pt")
  countryCode           String?                @db.Char(2)
  timezone              String?
  measurementSystem     MeasurementSystem?
  regionDetectionSource RegionDetectionSource?

  birthDate     DateTime?
  gender        Gender?
  heightCm      Float?
  weightKg      Float?
  activityLevel ActivityLevel?

  dietType            DietType?
  exerciseCalories    Boolean   @default(false)
  rolloverCalories    Boolean   @default(false)
  notificationsOptIn  Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)

  // Set once, the moment onboarding completes - grants full app access for
  // TRIAL_ACCESS_DAYS with no card required, before any Stripe/RevenueCat
  // entitlement exists. See SubscriptionAccessService.
  trialActivatedAt DateTime?

  referralCode         String?   @unique
  healthConnectOptIn   Boolean   @default(false)
  healthConnectOptInAt DateTime?

  guestInstallationHash String? @unique
  compedAccess          Boolean @default(false)
  isAdmin               Boolean @default(false)
  scanAccountGeneration Int     @default(1)

  // Lifetime free-tier usage counters (non-subscribers only). Never reset by
  // login/logout/reinstall/device change - tied to the account row itself,
  // same durability guarantee as compedAccess. See SubscriptionAccessService
  // and modules/scan for where these are read/incremented.
  freeScansUsed    Int     @default(0)
  freeMealLogsUsed Int     @default(0)
  freeDoseUsed     Boolean @default(false)

  refreshTokens           RefreshToken[]
  appleCredential         AppleCredential?
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  passwordResetTokens     PasswordResetToken[]
  consents                Consent[]
  goals                   Goal[]
  meals                   Meal[]
  dailyLogs               DailyLog[]
  streak                  Streak?
  billingSubject          BillingSubject?
  notificationPref        NotificationPreference?
  weeklySummaries         WeeklySummary[]
  referralsSent           Referral[]               @relation("ReferralInviter")
  referralReceived        Referral?                @relation("ReferralInvitee")
  userAchievements        UserAchievement[]

  gamificationProfile GamificationProfile?
  pointsEvents        PointsEvent[]
  userBadges          UserBadge[]

  medicationConsent     MedicationConsent?
  medications           Medication[]
  medicationLogs        MedicationLog[]
  waterEntries          WaterEntry[]
  weightEntries         WeightEntry[]
  syncMutations         SyncMutation[]
  syncChanges           SyncChange[]
  syncBootstrapSessions SyncBootstrapSession[]

  dietProfile           DietProfile?
  recipes               Recipe[]
  mealPlans             MealPlan[]
  workoutProfile        WorkoutProfile?
  workoutPlans          WorkoutPlan[]
  workoutSessions       WorkoutSession[]
  onboardingSubmissions OnboardingSubmission[]
  planMutations         PlanMutation[]

  scanJobs           ScanJob[]
  scanUsages         ScanUsage[]
  scanFeedbacks      ScanFeedback[]
  scanFeedbackUsages ScanFeedbackUsage[]

  glp1Consents            Glp1Consent[]
  glp1Treatments          Glp1Treatment[]
  glp1DosePlanPeriods     Glp1DosePlanPeriod[]
  glp1DoseEvents          Glp1DoseEvent[]
  glp1SymptomEvents       Glp1SymptomEvent[]
  glp1ReminderRules       Glp1ReminderRule[]
  glp1InjectionSiteStates Glp1InjectionSiteState[]
  glp1SetupSubmissions    Glp1SetupSubmission[]

  productAnalyticsEvents ProductAnalyticsEvent[]

  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityLikes    CommunityLike[]
  communityReports  CommunityReport[]

  supportChatConversations SupportChatConversation[]
  suggestions              Suggestion[]

  directChatParticipants DirectChatParticipant[]
  directChatMessages     DirectChatMessage[]

  sentFriendships     CommunityFriendship[] @relation("UserFriends")
  receivedFriendships CommunityFriendship[] @relation("FriendUsers")

  trainerProfile          TrainerProfile?
  enrolledTrainerPrograms TrainerProgramEnrollment[]

  trainingWorkouts TrainingWorkout[]
  trainingChallenges TrainingChallengeEntry[]
  stories    CommunityStory[]
  storyViews CommunityStoryView[]
  storyLikes CommunityStoryLike[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([provider, providerId])
  @@index([email])
  @@index([referralCode])
  @@map("users")
}

model AppleCredential {
  userId          String   @id
  tokenCiphertext String
  tokenIv         String
  tokenTag        String
  tokenType       String
  tokenKeyId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("apple_credentials")
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

enum AuthProvider {
  GUEST
  EMAIL
  GOOGLE
  APPLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MeasurementSystem {
  METRIC
  IMPERIAL
}

enum RegionDetectionSource {
  DEVICE_REGION
  TIMEZONE
  MANUAL
}

enum MedicationMarket {
  BRAZIL
  UNITED_STATES
  EUROPE
  ASIA
  INTERNATIONAL
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum DietType {
  OMNIVORE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETO
  CARNIVORE
  OTHER
}

model RefreshToken {
  id         String    @id @default(cuid())
  token      String    @unique
  familyId   String?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OAuthAuthorizationCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientState   String
  codeChallenge String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("oauth_authorization_codes")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum GoalType {
  LOSE_WEIGHT
  GAIN_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
}

enum GoalSpeed {
  SLOW
  MODERATE
  FAST
}

model Goal {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 GoalType
  targetWeightKg       Float?
  dailyCalories        Int
  dailyProteinG        Float?
  dailyCarbsG          Float?
  dailyFatG            Float?
  dailyFiberG          Float
  waterMl              Int?
  goalSpeed            GoalSpeed?
  weeklyGoalKg         Float?
  algorithmVersion     String     @default("mifflin-st-jeor-v5-disclosed-adult-targets")
  calculationInputJson Json?
  startDate            DateTime   @default(now())
  targetDate           DateTime?
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([userId, isActive])
  @@map("goals")
}

enum FoodSource {
  TACO
  USDA
  AI_GENERATED
}

model FoodItem {
  id             String  @id @default(cuid())
  name           String
  nameNormalized String
  category       String?
  brandName      String?

  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float

  defaultPortionG     Float?
  defaultPortionLabel String?

  source         FoodSource
  timesUsed      Int        @default(0)
  timesValidated Int        @default(0)
  isVerified     Boolean    @default(false)
  imageHashes    String[]

  mealItems MealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nameNormalized, brandName])
  @@index([nameNormalized])
  @@index([category])
  @@map("food_items")
}

enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  SUPPER
}

model Meal {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  type           MealType
  imageUrl       String?
  imageHash      String?
  aiRaw          Json?
  totalCalories  Float
  totalProteinG  Float
  totalCarbsG    Float
  totalFatG      Float
  totalFiberG    Float    @default(0)
  confidence     Float?
  wasEdited      Boolean  @default(false)
  loggedAt       DateTime @default(now())

  items      MealItem[]
  dailyLog   DailyLog?  @relation(fields: [dailyLogId], references: [id])
  dailyLogId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, loggedAt])
  @@index([imageHash])
  @@map("meals")
}

model MealItem {
  id           String    @id @default(cuid())
  mealId       String
  meal         Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItemId   String?
  foodItem     FoodItem? @relation(fields: [foodItemId], references: [id])
  name         String
  portionG     Float
  portionLabel String?
  calories     Float
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float     @default(0)
  quantity     Float     @default(1)

  createdAt DateTime @default(now())

  @@index([mealId])
  @@index([foodItemId])
  @@map("meal_items")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  route       String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, route, windowStart])
  @@index([route, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model DailyLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  totalCalories Float @default(0)
  totalProteinG Float @default(0)
  totalCarbsG   Float @default(0)
  totalFatG     Float @default(0)
  totalFiberG   Float @default(0)
  totalWaterMl  Float @default(0)

  targetCalories Int?
  targetProteinG Float?
  targetCarbsG   Float?
  targetFatG     Float?

  weightKg Float?

  meals         Meal[]
  waterEntries  WaterEntry[]
  weightEntries WeightEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_logs")
}

model WaterEntry {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLogId       String
  dailyLog         DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  amountMl         Float
  clientMutationId String?
  loggedAt         DateTime @default(now())

  @@unique([userId, clientMutationId])
  @@index([userId])
  @@map("water_entries")
}

model WeightEntry {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyLogId       String
  dailyLog         DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  weightKg         Float
  clientMutationId String?
  measuredAt       DateTime
  createdAt        DateTime @default(now())

  @@unique([userId, clientMutationId])
  @@index([userId, measuredAt])
  @@index([dailyLogId, measuredAt])
  @@map("weight_entries")
}

enum SyncMutationStatus {
  PROCESSING
  APPLIED
  REJECTED
}

enum SyncChangeAction {
  UPSERT
  DELETE
}

enum ScanAccountCleanupStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
}

enum ScanJobStatus {
  PROCESSING
  COMPLETED
  FAILED_FINAL
  CANCELED
}

// AI food-photo scanning. Runs in-process (see modules/scan) - the image
// itself is never persisted, only the analysis result. Rows cascade-delete
// with their User, unlike ScanAccountCleanupTask below which deliberately
// survives it.
model ScanJob {
  id              String        @id
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyHash String
  contentSha256   String
  contentType     String
  sizeBytes       Int
  locale          String
  quotaDay        String
  dailyLimit      Int
  status          ScanJobStatus
  leaseToken      String?
  leaseExpiresAt  DateTime?
  result          Json?
  provider        String?
  imageHash       String?
  errorCode       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expiresAt       DateTime

  @@unique([userId, idempotencyHash])
  @@index([userId, quotaDay, status])
  @@index([expiresAt])
  @@map("scan_jobs")
}

// One row per (user, UTC day) - tracks completed scans and total attempts
// against the daily limits enforced in ScanService.
model ScanUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotaDay  String
  completed Int      @default(0)
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, quotaDay])
  @@map("scan_usage")
}

// User-edited portion corrections on a completed scan, feeding
// buildPortionCalibrationProfile() so future scans for the same foods start
// from a calibrated estimate.
model ScanFeedback {
  id          String   @id @default(cuid())
  scanId      String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payloadHash String
  edited      Boolean
  rawItems    Json
  savedItems  Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("scan_feedback")
}

model ScanFeedbackUsage {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotaDay       String
  acceptedCount  Int       @default(0)
  lastAcceptedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([userId, quotaDay])
  @@map("scan_feedback_usage")
}

model SyncMutation {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutationId     String
  installationId String             @db.Uuid
  sequence       Int
  operation      String
  entityId       String
  requestHash    String
  status         SyncMutationStatus @default(PROCESSING)
  resultJson     Json?
  errorCode      String?
  occurredAt     DateTime
  processedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([userId, mutationId])
  @@unique([userId, installationId, sequence])
  @@index([userId, sequence])
  @@index([userId, createdAt])
  @@index([status, processedAt])
  @@map("sync_mutations")
}

model SyncBootstrapSession {
  id               String   @id @db.Uuid
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotRevision BigInt
  itemsJson        Json
  totalItems       Int
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sync_bootstrap_sessions")
}

// Singleton global clock for the sync protocol. It deliberately has no User
// relation, so deleting an account can cascade its journal rows without ever
// moving the global watermark backwards.
model SyncState {
  id              Int      @id @default(1)
  currentRevision BigInt   @default(1)
  retentionFloor  BigInt   @default(1)
  updatedAt       DateTime @updatedAt

  @@map("sync_state")
}

model SyncChange {
  // Filled by the database trigger that atomically advances SyncState.
  revision   BigInt           @id @default(dbgenerated())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     SyncChangeAction @default(UPSERT)
  version    Int?
  dataJson   Json?
  mutationId String?
  occurredAt DateTime
  createdAt  DateTime         @default(now())

  @@index([userId, revision])
  @@index([createdAt, revision])
  @@map("sync_changes")
}

// Deliberately has no User relation or foreign key. The task must survive the
// local account deletion that creates it in the same database transaction.
model ScanAccountCleanupTask {
  id                      String                   @id @db.Uuid
  subjectId               String?
  subjectHash             String                   @unique @db.Char(64)
  providerSubjectHash     String?                  @unique @db.Char(64)
  accountGeneration       Int                      @default(1)
  appleRevocationRequired Boolean                  @default(false)
  appleTokenCiphertext    String?
  appleTokenIv            String?
  appleTokenTag           String?
  appleTokenType          String?
  appleTokenKeyId         String?
  appleRevokedAt          DateTime?
  revenueCatDeletedAt     DateTime?
  status                  ScanAccountCleanupStatus @default(PENDING)
  attempts                Int                      @default(0)
  nextAttemptAt           DateTime                 @default(now())
  leaseToken              String?                  @db.Uuid
  leaseExpiresAt          DateTime?
  lastAttemptAt           DateTime?
  lastErrorCode           String?
  completedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([completedAt])
  @@map("scan_account_cleanup_tasks")
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @db.Date
  updatedAt      DateTime @updatedAt

  @@map("streaks")
}

model Consent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  version   String
  accepted  Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("consents")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  EXPIRED
}

enum PlanType {
  PREMIUM_WEEKLY
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum BillingProvider {
  APP_STORE
  PLAY_STORE
  REVENUECAT_UNKNOWN
  STRIPE
}

enum BillingManagementProvider {
  APP_STORE
  PLAY_STORE
  REVENUECAT_UNKNOWN
  STRIPE
  NONE
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  breakfast          Boolean @default(false)
  breakfastTime      String  @default("07:00")
  lunch              Boolean @default(false)
  lunchTime          String  @default("12:00")
  afternoonSnack     Boolean @default(false)
  afternoonSnackTime String  @default("15:00")
  dinner             Boolean @default(false)
  dinnerTime         String  @default("19:00")

  water          Boolean @default(false)
  waterIntervalH Int     @default(2)
  waterStartTime String  @default("08:00")
  waterEndTime   String  @default("22:00")

  workout         Boolean @default(false)
  workoutTime     String  @default("18:00")
  workoutDaysJson Json    @default("[1,3,5]")

  progressCheck        Boolean @default(false)
  progressCheckTime    String  @default("09:00")
  progressCheckWeekday Int     @default(1)

  streakRisk     Boolean @default(false)
  streakRiskTime String  @default("21:00")

  pushEnabled      Boolean @default(false)
  pushSubscription Json?

  // Logical ordering metadata for durable offline desired-state writes.
  // Legacy REST writes clear these fields so a later sync cannot silently
  // overwrite a state changed through another path.
  syncOccurredAt     DateTime?
  syncMutationId     String?   @db.Uuid
  syncInstallationId String?   @db.Uuid
  syncSequence       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model WeeklySummary {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  weekEnd   DateTime @db.Date

  avgCalories Float
  avgProteinG Float
  avgCarbsG   Float
  avgFatG     Float
  totalMeals  Int
  daysLogged  Int
  avgWaterMl  Float

  startWeightKg  Float?
  endWeightKg    Float?
  weightChangeKg Float?

  targetCalories   Int?
  adherencePercent Float?

  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@map("weekly_summaries")
}

model AchievementDefinition {
  id        String   @id @default(cuid())
  slug      String   @unique
  icon      String
  sortOrder Int      @default(0)
  criteria  Json
  createdAt DateTime @default(now())

  userAchievements UserAchievement[]

  @@map("achievement_definitions")
}

model UserAchievement {
  id            String                @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model Referral {
  id        String         @id @default(cuid())
  inviterId String
  inviteeId String         @unique
  status    ReferralStatus @default(PENDING)
  createdAt DateTime       @default(now())
  inviter   User           @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User           @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@map("referrals")
}

model RevenueCatWebhookEvent {
  id          String             @id
  type        String
  status      WebhookEventStatus @default(PROCESSING)
  error       String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("revenuecat_webhook_events")
}

model StripeCheckoutAttempt {
  id                String         @id @default(uuid()) @db.Uuid
  billingSubjectId  String         @db.Uuid
  billingSubject    BillingSubject @relation(fields: [billingSubjectId], references: [id], onDelete: Cascade)
  idempotencyKey    String
  plan              PlanType
  market            String
  currency          String
  priceId           String
  checkoutSessionId String?        @unique
  stripeCustomerId  String?
  claimTokenHash    String?        @unique
  claimExpiresAt    DateTime?
  claimedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([billingSubjectId, idempotencyKey])
  @@index([billingSubjectId, createdAt])
  @@map("stripe_checkout_attempts")
}

model StripeWebhookEvent {
  id          String             @id
  type        String
  status      WebhookEventStatus @default(PROCESSING)
  error       String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("stripe_webhook_events")
}

// Opaque, non-authenticating owner for billing and reporting evidence. Account
// deletion detaches userId while preserving provider reconciliation history.
model BillingSubject {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @unique
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  detachedAt DateTime?
