NODE_ENV=development
# Se outro servico ja usa 3000 (ex.: outro Express), use 3001 e VITE_DEV_PROXY_TARGET=http://localhost:3001 no web.
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Lista separada por vírgula; origem exata (scheme + host + porta).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Em producao com multiplas instancias/replicas (ex.: escalonamento horizontal
# no Render), cada instancia abre seu proprio pool de conexoes do Prisma
# Client sem limite explicito por padrao. Para evitar esgotar as conexoes do
# Postgres gerenciado, considere limitar o pool por instancia via query param:
# postgresql://user:pass@host:5432/db?connection_limit=5&pool_timeout=10
# (ajuste connection_limit * numero de instancias <= limite do plano do Postgres),
# ou usar um pooler externo (PgBouncer / Supabase Pooler) na frente do banco.
DATABASE_URL=postgresql://nutriscan:nutriscan@localhost:5434/nutriscan

JWT_ACCESS_SECRET=change-me-access-secret-64-chars-min
# Deve ser positivo e no maximo 30d, igual a retencao do receipt de exclusao.
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-64-chars-min
JWT_REFRESH_EXPIRATION=7d

GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=com.strivo.fitness.app
# Server-side Sign in with Apple key. Store the .p8 contents as base64; never expose it to mobile.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
# Chave AES-256 exclusiva para tokens de revogacao Apple. Nao reutilize JWT secrets.
# APPLE_TOKEN_ENCRYPTION_KEY_ID=apple-v1
# APPLE_TOKEN_ENCRYPTION_KEY_BASE64=<32 bytes em base64>
# JSON opcional com chaves antigas mantidas somente durante a drenagem/rotacao.
# Inclua legacy-jwt-refresh-v1 antes de rotacionar JWT_REFRESH_SECRET se ainda houver ciphertext legado.
# APPLE_TOKEN_ENCRYPTION_PREVIOUS_KEYS={"apple-v0":"<32 bytes em base64>","legacy-jwt-refresh-v1":"<32 bytes em base64>"}
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# AI food-photo scanning (modules/scan) - runs in-process, no separate
# service. Both required together; leave both empty to disable the feature
# (scan endpoints return a clean 503 instead of failing to boot).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_SCAN_MODEL=gpt-5-nano
SCAN_PRIMARY_TIMEOUT_MS=6000
SCAN_FALLBACK_TIMEOUT_MS=8000

# AI support chat (modules/support-chat) - a SEPARATE Gemini API key from
# GEMINI_API_KEY above, by design (see env.schema.ts for why: keeps the
# chat's quota/cost independent from the scanner's). Get one for free at
# https://aistudio.google.com/apikey. Leave empty to disable the feature
# (chat endpoints return a clean 503 instead of failing to boot).
SUPPORT_CHAT_GEMINI_API_KEY=
SUPPORT_CHAT_GEMINI_MODEL=gemini-2.5-flash-lite
SUPPORT_CHAT_TIMEOUT_MS=15000

ENABLE_LOAD_TEST=false
# IMPORTANT: leave this commented out (not "LOAD_TEST_KEY="). env.schema.ts
# defines it as z.string().min(32).optional() — .optional() only accepts
# `undefined`, not an empty string. dotenv loads "KEY=" as "", which then
# fails the min(32) check and crashes the API at boot (ConfigModule calls
# process.exit(1) on any invalid var, even ones that are conceptually
# "optional"). Confirmed by running the schema against this file directly.
# LOAD_TEST_KEY=

# Operational flags read by env.schema.ts. Both default to true when unset
# (only the literal string "false" disables them) — listed here explicitly
# so they aren't missed when reviewing/copying this file.
RATE_LIMIT_ENABLED=true
BACKGROUND_JOBS_ENABLED=true

# Stripe web billing: configure only when web subscriptions are enabled.
# IMPORTANT: keep every STRIPE_* key below commented out unless you are
# actually setting STRIPE_ENABLED=true. Same reason as LOAD_TEST_KEY above:
# each of these is `.min(N).optional()` in env.schema.ts, so an empty string
# ("KEY=" with nothing after it) fails validation and crashes the API at
# boot — it does NOT behave like "leave blank to disable".
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_US_MONTHLY=
# STRIPE_PRICE_US_YEARLY=
# STRIPE_PRICE_CA_MONTHLY=
# STRIPE_PRICE_CA_YEARLY=
# STRIPE_PRICE_GB_MONTHLY=
# STRIPE_PRICE_GB_YEARLY=
# STRIPE_PRICE_DE_MONTHLY=
# STRIPE_PRICE_DE_YEARLY=
# STRIPE_PRICE_FR_MONTHLY=
# STRIPE_PRICE_FR_YEARLY=

# Direct Apple subscriptions (server-only; separate from Sign in with Apple).
# Set all three credentials together. Generate an In-App Purchase key in App Store Connect.
# Optional legacy receipt validation; keep this backend-only.
# APPLE_IAP_SHARED_SECRET=
# APPLE_IAP_KEY_ID=
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_PRIVATE_KEY_BASE64=
APPLE_IAP_BUNDLE_ID=com.strivo.fitness.app
APPLE_IAP_APP_ID=6826407080
APPLE_IAP_MONTHLY_PRODUCT_ID=monthly_29_99
APPLE_IAP_ENVIRONMENT=Production

# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY have no min()/format check, so an
# empty value is harmless. VAPID_SUBJECT is `z.string().email().optional()`
# though — an empty string is not a valid email and WILL crash boot, so it
# must stay commented out until you have a real "mailto:you@example.com".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

DEV_SEED_EMAIL=matheus@nutriscan.dev
DEV_SEED_PASSWORD=nutriscan-dev-1
DEV_SEED_NAME=Matheus

# prisma/seeds/seed.ts also creates a second account with premium comp
# access ("ADMIN USER"). If these are left unset, the script falls back to
# hardcoded defaults in its own source (admin@calordiet.com /
# C@lorDiet123) — set your own local-only values here so a real password
# isn't the one silently used. Not part of env.schema.ts; read directly by
# the seed script via process.env, and skipped in production unless
# SEED_ADMIN_USER=true is also set.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# Training AI: dedicated key recommended; otherwise uses GEMINI_API_KEY, then support-chat credentials.
TRAINING_GEMINI_API_KEY=
TRAINING_GEMINI_MODEL=
