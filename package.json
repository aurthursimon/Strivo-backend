{
  "name": "nutriscan-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm --prefix packages/api start",
    "dev:docker": "bash scripts/dev-docker-stack.sh",
    "dev:all": "bash scripts/dev-docker-stack.sh",
    "dev": "turbo dev --dangerously-disable-package-manager-check",
    "build": "turbo build --dangerously-disable-package-manager-check",
    "lint": "turbo lint --dangerously-disable-package-manager-check",
    "test": "turbo test --dangerously-disable-package-manager-check",
    "typecheck": "turbo typecheck --dangerously-disable-package-manager-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "pnpm": "^11.0.8",
    "prettier": "^3.8.3",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
